{
  "paths": {
    "source": [
      "apps/**",
      "libs/**"
    ],
    "heavy": [
      "**/migrations/**",
      "**/prisma/schema.prisma",
      "libs/contracts/**",
      "libs/kernel/**",
      "libs/*/src/domain/**/*.port.ts",
      "tsconfig.base.json",
      "pnpm-workspace.yaml"
    ],
    "protected": [
      "**/tsconfig*.json",
      ".github/workflows/**"
    ]
  },
  "packages": [
    "apps/*",
    "libs/*"
  ],
  "caps": {
    "fileLinesByPath": {
      "libs/*/src/domain/**": 200
    }
  },
  "checks": [
    {
      "id": "typecheck",
      "run": "pnpm -s exec tsc -p tsconfig.json --noEmit --incremental --tsBuildInfoFile node_modules/.cache/keel/tsc.tsbuildinfo",
      "stages": [
        "stop"
      ]
    },
    {
      "id": "lint",
      "run": "pnpm -s exec eslint --max-warnings 0 {files}",
      "stages": [
        "stop"
      ],
      "files": [
        "apps/**/*.ts",
        "libs/**/*.ts"
      ]
    },
    {
      "id": "arch",
      "run": "pnpm -s exec depcruise --config .dependency-cruiser.cjs {files}",
      "stages": [
        "stop"
      ],
      "files": [
        "apps/**/*.ts",
        "libs/**/*.ts"
      ]
    },
    {
      "id": "test",
      "run": "pnpm -s exec vitest related --run --passWithNoTests {files}",
      "stages": [
        "stop"
      ],
      "files": [
        "apps/**/*.ts",
        "libs/**/*.ts"
      ]
    },
    {
      "id": "typecheck-all",
      "run": "pnpm -s typecheck",
      "stages": [
        "ci"
      ]
    },
    {
      "id": "lint-all",
      "run": "pnpm -s lint",
      "stages": [
        "ci"
      ]
    },
    {
      "id": "arch-all",
      "run": "pnpm -s arch",
      "stages": [
        "ci"
      ]
    },
    {
      "id": "test-all",
      "run": "pnpm -s test",
      "stages": [
        "ci"
      ]
    },
    {
      "id": "coverage",
      "run": "pnpm -s coverage",
      "stages": [
        "ci"
      ]
    }
  ],
  "sandboxProbes": [
    {
      "id": "pnpm",
      "run": "pnpm store add is-number@7.0.0",
      "why": "installing packages",
      "fix": "pnpm must keep its store inside the project (storeDir: .pnpm-store in pnpm-workspace.yaml, which keel-nestjs adopt sets) and the registry host must be in sandbox.network.allowedDomains"
    },
    {
      "id": "docker",
      "run": "docker version",
      "requires": "docker version",
      "whenFiles": [
        "docker-compose.yml",
        "docker-compose.yaml",
        "compose.yml",
        "compose.yaml"
      ],
      "why": "databases the project runs in containers",
      "fix": "docker cannot run inside the sandbox: start the databases from your terminal (docker compose up -d), or add \"docker *\" to sandbox.excludedCommands so docker runs outside it"
    }
  ]
}
